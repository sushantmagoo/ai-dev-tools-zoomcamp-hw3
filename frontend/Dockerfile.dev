FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# Source is bind-mounted by docker-compose.dev.yml, so Vite's dev server
# picks up host edits. --host makes it reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
