# Copy to .env and edit as needed. If DATABASE_URL is unset entirely, the
# app defaults to a local SQLite file (sqlite:///./ledger.db).

# SQLite (default, no setup required)
# DATABASE_URL=sqlite:///./ledger.db

# Postgres (run `make db-up` first to start the container)
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger
